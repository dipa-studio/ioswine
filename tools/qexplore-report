#!/usr/bin/env python3
"""qexplore-report - symbolize qemu exploration logs and write host-fault-census.md."""

import argparse
import bisect
import datetime
import glob
import json
import os
import re
import shutil
import subprocess
import sys
from collections import defaultdict

REPO = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
DSC_PATH = os.path.join(REPO, "vendor-local/23G90__iPhone17,3/dyld_shared_cache_arm64e")
LSK_DYLIB = os.path.join(REPO, "build/libsystem_kernel.dylib")
AIDOKU_BIN = os.path.join(REPO, "vendor-local/apps/aidoku-0.9-4/x/Payload/Aidoku.app/Aidoku")
CACHE_PATH = os.path.join(REPO, "build/tmp/qexplore-a2s-cache.json")
LSK_BASE = 0x300000000
LSK_END = 0x310000000
DSC_BASE = 0x180000000
DSC_END = 0x2C3000000
APP_BASE = 0x100000000
APP_END = 0x180000000

SIG_NAMES = {
    4: "SIGILL",
    5: "SIGTRAP",
    6: "SIGABRT",
    7: "SIGBUS",
    11: "SIGSEGV",
    15: "SIGTERM",
}


def find_llvm_nm():
    p = shutil.which("llvm-nm")
    if p:
        return p
    ndk = os.environ.get("ANDROID_NDK_HOME")
    if ndk:
        cand = os.path.join(ndk, "toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-nm")
        if os.path.isfile(cand):
            return cand
    cands = sorted(glob.glob(os.path.expanduser("~/Android/ndk/") + "*/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-nm"))
    return cands[-1] if cands else None


def load_nm_symbols(llvm_nm, binary):
    if not llvm_nm or not os.path.isfile(binary):
        return [], []
    try:
        out = subprocess.check_output([llvm_nm, "-n", binary], text=True, stderr=subprocess.DEVNULL)
    except subprocess.SubprocessError:
        return [], []
    addrs = []
    names = []
    for line in out.splitlines():
        parts = line.split(None, 2)
        if len(parts) == 3:
            try:
                addr = int(parts[0], 16)
            except ValueError:
                continue
            addrs.append(addr)
            names.append(parts[2])
    return addrs, names


def lookup_nm(addrs, names, offset):
    if not addrs:
        return None
    idx = bisect.bisect_right(addrs, offset) - 1
    if idx < 0:
        return None
    delta = offset - addrs[idx]
    return f"{names[idx]} + {delta}" if delta else names[idx]


def load_a2s_cache():
    if os.path.isfile(CACHE_PATH):
        try:
            with open(CACHE_PATH, "r", encoding="utf-8") as f:
                return json.load(f)
        except (OSError, json.JSONDecodeError):
            pass
    return {}


def save_a2s_cache(cache):
    os.makedirs(os.path.dirname(CACHE_PATH), exist_ok=True)
    tmp = CACHE_PATH + f".tmp.{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(cache, f, indent=2, sort_keys=True)
    os.replace(tmp, CACHE_PATH)


def symbolize_dsc(addr_hex, cache):
    if addr_hex in cache:
        return cache[addr_hex]
    if not os.path.isfile(DSC_PATH):
        return f"dsc:{addr_hex}"
    try:
        proc = subprocess.run(
            ["ipsw", "dyld", "a2s", DSC_PATH, addr_hex],
            capture_output=True,
            text=True,
            timeout=30,
        )
        out = (proc.stdout or "") + "\n" + (proc.stderr or "")
    except subprocess.SubprocessError as e:
        out = str(e)

    dylib = ""
    sym = ""
    for line in out.splitlines():
        m_dylib = re.search(r"dylib=([^\s]+)", line)
        if m_dylib:
            dylib = os.path.basename(m_dylib.group(1))
        m_sym = re.match(r"^0x[0-9a-fA-F]+:\s*(.+?)\s*$", line.strip())
        if m_sym:
            sym = m_sym.group(1)

    if sym and dylib:
        res = f"{sym} ({dylib})"
    elif sym:
        res = sym
    elif dylib:
        res = f"{addr_hex} ({dylib})"
    else:
        res = addr_hex
    cache[addr_hex] = res
    return res


def symbolize_addr(addr_str, lsk_syms, app_syms, a2s_cache):
    if not addr_str:
        return "-"
    try:
        val = int(addr_str, 16)
    except ValueError:
        return addr_str
    if val == 0:
        return "0x0"
    norm = f"0x{val:x}"
    if LSK_BASE <= val < LSK_END:
        s = lookup_nm(lsk_syms[0], lsk_syms[1], val - LSK_BASE)
        return f"{s} (libsystem_kernel.dylib)" if s else f"lsk+0x{val - LSK_BASE:x}"
    if DSC_BASE <= val < DSC_END:
        return symbolize_dsc(norm, a2s_cache)
    if APP_BASE <= val < APP_END:
        s = lookup_nm(app_syms[0], app_syms[1], val)
        if s:
            return f"{s} (Aidoku)"
        return f"Aidoku+0x{val - APP_BASE:x}"
    return norm


def natural_log_key(path):
    base = os.path.basename(path)
    m = re.match(r"^(\d+)-(\d+)\.log$", base)
    if m:
        return (0, int(m.group(1)), int(m.group(2)), base)
    return (1, 0, 0, base)


def fmt_sig(sig_hex):
    if not sig_hex:
        return "-"
    try:
        num = int(sig_hex, 16)
    except ValueError:
        return sig_hex
    name = SIG_NAMES.get(num)
    return f"{name} ({num})" if name else f"sig={num}"


def md_escape(s):
    return s.replace("|", "\\|").replace("\n", " ").strip()


def parse_log(path):
    rel = os.path.relpath(path, REPO) if path.startswith(REPO) else path
    base = os.path.basename(path)
    m_fn = re.match(r"^([^.-]+)-(\d+)\.log$", base)
    seed = m_fn.group(1) if m_fn else "?"
    run_no = m_fn.group(2) if m_fn else "?"

    frames = 0
    actions = []
    crashes = []
    reasons = []
    nsexceptions = []
    fatals = []
    meta = {}

    re_crash = re.compile(
        r"\[lsk CRASH\]\s+sig=(0x[0-9a-fA-F]+)\s+pc=(0x[0-9a-fA-F]+)\s+lr=(0x[0-9a-fA-F]+)"
    )
    re_meta = re.compile(
        r"\[qexplore\]\s+seed=(\S+)\s+run=(\S+)\s+reason=(\S+)\s+rc=(\S+)\s+elapsed=(\S+)\s+frames=(\S+)"
    )

    with open(path, "r", encoding="utf-8", errors="replace") as f:
        for line in f:
            line = line.rstrip("\r\n")
            if "[snapshot] frame " in line or "[carender] frame " in line:
                frames += 1
            if line.startswith("[monkey] "):
                actions.append(line[len("[monkey] "):])
            mc = re_crash.search(line)
            if mc:
                crashes.append({
                    "sig": mc.group(1),
                    "pc": mc.group(2),
                    "lr": mc.group(3),
                    "line": line,
                })
            if "[nsexception]" in line:
                nsexceptions.append(line.strip())
            elif "Terminating app due to uncaught exception" in line:
                reasons.append(line.strip())
            elif re.match(r"^\s*reason:\s*", line):
                reasons.append(line.strip())
            elif "FATAL" in line and "api slot" not in line:
                fatals.append(line.strip())
            mm = re_meta.search(line)
            if mm:
                meta = {
                    "seed": mm.group(1),
                    "run": mm.group(2),
                    "reason": mm.group(3),
                    "rc": mm.group(4),
                    "elapsed": mm.group(5),
                    "frames": mm.group(6),
                }

    if meta:
        seed = meta.get("seed", seed)
        run_no = meta.get("run", run_no)

    last_actions = actions[-4:]
    end_reason = meta.get("reason", "unknown")
    rc = meta.get("rc", "?")
    elapsed = meta.get("elapsed", "?")

    reason_text = ""
    if reasons:
        reason_text = reasons[0]
    elif nsexceptions:
        reason_text = nsexceptions[0]
    elif fatals:
        reason_text = fatals[0]

    if crashes:
        c = crashes[0]
        outcome = "fault"
        kind = "crash"
        sig_hex = c["sig"]
        pc_hex = f"0x{int(c['pc'], 16):x}"
        lr_hex = f"0x{int(c['lr'], 16):x}"
    elif reason_text:
        outcome = "fault"
        kind = "nsexception" if nsexceptions or reasons else "fatal"
        sig_hex = ""
        pc_hex = ""
        lr_hex = ""
    elif end_reason == "stall":
        outcome = "fault"
        kind = "stall"
        sig_hex = ""
        pc_hex = ""
        lr_hex = ""
        reason_text = (
            f"no new frame for 30s (at {frames} frames)"
            if frames > 0
            else "boot stall (0 frames in 90s)"
        )
    elif end_reason == "budget" or (end_reason == "exit" and rc == "0"):
        outcome = "survived"
        kind = end_reason
        sig_hex = ""
        pc_hex = ""
        lr_hex = ""
    else:
        outcome = "fault"
        kind = "exit"
        sig_hex = ""
        pc_hex = ""
        lr_hex = ""
        reason_text = f"process exited reason={end_reason} rc={rc}"

    return {
        "path": rel,
        "seed": seed,
        "run": run_no,
        "frames": frames,
        "elapsed": elapsed,
        "end_reason": end_reason,
        "rc": rc,
        "outcome": outcome,
        "kind": kind,
        "sig_hex": sig_hex,
        "pc_hex": pc_hex,
        "lr_hex": lr_hex,
        "reason": reason_text,
        "last_actions": last_actions,
    }


def main():
    ap = argparse.ArgumentParser
    ap.add_argument("--logs", default=os.path.join(REPO, "build/qexplore"), help="Directory containing SEED-N.log files")
    ap.add_argument("--out", default=os.path.join, help="Output markdown path")
    ap.add_argument("files", nargs="*", help="Optional explicit log files")
    args = ap.parse_args()

    if args.files:
        log_files = sorted(args.files, key=natural_log_key)
    else:
        log_files = sorted(glob.glob(os.path.join(args.logs, "*.log")), key=natural_log_key)

    if not log_files:
        print(f"qexplore-report: no log files found in {args.logs}", file=sys.stderr)
        return 1

    records = [parse_log(p) for p in log_files]

    llvm_nm = find_llvm_nm()
    lsk_syms = load_nm_symbols(llvm_nm, LSK_DYLIB)
    app_syms = load_nm_symbols(llvm_nm, AIDOKU_BIN)
    a2s_cache = load_a2s_cache()

    distinct_addrs = sorted(
        {r["pc_hex"] for r in records if r["pc_hex"]}
        | {r["lr_hex"] for r in records if r["lr_hex"]}
    )
    addr_syms = {}
    for addr in distinct_addrs:
        addr_syms[addr] = symbolize_addr(addr, lsk_syms, app_syms, a2s_cache)
    save_a2s_cache(a2s_cache)

    fault_groups = defaultdict(list)
    for r in records:
        if r["outcome"] != "fault":
            continue
        if r["kind"] == "crash":
            pc_sym = addr_syms.get(r["pc_hex"], r["pc_hex"])
            lr_sym = addr_syms.get(r["lr_hex"], r["lr_hex"])
            sig_key = ("crash", fmt_sig(r["sig_hex"]), pc_sym, lr_sym, r["reason"] or "-")
        elif r["kind"] == "stall":
            sub = "boot stall (0 frames)" if r["frames"] == 0 else "no new frame for 30s"
            sig_key = ("stall", "stall", "-", "-", sub)
        else:
            sig_key = (r["kind"], r["kind"], "-", "-", r["reason"] or "-")
        fault_groups[sig_key].append(r)

    sorted_groups = sorted(
        fault_groups.items(),
        key=lambda kv: (-len(kv[1]), kv[0][0], kv[0][2], kv[0][4]),
    )

    total_runs = len(records)
    seeds = sorted({r["seed"] for r in records}, key=lambda s: (0, int(s)) if s.isdigit() else (1, s))
    total_frames = sum(r["frames"] for r in records)
    survived_runs = sum(1 for r in records if r["outcome"] == "survived")
    fault_runs = sum(1 for r in records if r["outcome"] == "fault")
    crash_runs = sum(1 for r in records if r["kind"] == "crash")
    stall_runs = sum(1 for r in records if r["kind"] == "stall")
    other_fault_runs = fault_runs - crash_runs - stall_runs

    os.makedirs(os.path.dirname(args.out), exist_ok=True)
    now_str = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")

    lines = []
    lines.append("# Aidoku Host (QEMU) Fault Census")
    lines.append("")
    lines.append(f"- **Generated:** {now_str}")
    lines.append(f"- **Seeds:** {', '.join(seeds)} ({len(seeds)} parallel sessions)")
    lines.append(f"- **Total Runs Accounted For:** {total_runs} / {total_runs}")
    lines.append(f"- **Faulted Runs:** {fault_runs} ({crash_runs} crashes, {stall_runs} stalls, {other_fault_runs} other faults)")
    lines.append(f"- **Survived Budget Runs:** {survived_runs}")
    lines.append(f"- **Total Rendered Frames:** {total_frames}")
    lines.append("")
    lines.append("## Fault Signatures (Sorted by Count)")
    lines.append("")
    if sorted_groups:
        lines.append("| Rank | Count | Kind / Signal | PC Symbol | LR Symbol | Reason | Last Actions | Example Log |")
        lines.append("|:---:|:---:|:---|:---|:---|:---|:---|:---|")
        for idx, (sig_key, grp) in enumerate(sorted_groups, 1):
            kind, sig_disp, pc_sym, lr_sym, reason_disp = sig_key
            ex = grp[0]
            pc_cell = f"`{md_escape(pc_sym)}` (`{ex['pc_hex']}`)" if ex["pc_hex"] else "-"
            lr_cell = f"`{md_escape(lr_sym)}` (`{ex['lr_hex']}`)" if ex["lr_hex"] else "-"
            acts = ", ".join(ex["last_actions"]) if ex["last_actions"] else "(none)"
            lines.append(
                f"| {idx} | {len(grp)} | {md_escape(sig_disp)} | {pc_cell} | {lr_cell} | "
                f"{md_escape(reason_disp)} | `{md_escape(acts)}` | `{ex['path']}` |"
            )
    else:
        lines.append("_No faults observed across all runs._")

    lines.append("")
    if distinct_addrs:
        lines.append("## Symbolized Addresses")
        lines.append("")
        lines.append("| Address | Symbol |")
        lines.append("|:---|:---|")
        for addr in distinct_addrs:
            lines.append(f"| `{addr}` | `{md_escape(addr_syms[addr])}` |")
        lines.append("")

    lines.append("## All Runs Accounted For")
    lines.append("")
    lines.append("| Seed | Run | Outcome | Kind / Signal | Elapsed | Frames | Last Actions | Log Path |")
    lines.append("|:---:|:---:|:---|:---|:---:|:---:|:---|:---|")
    for r in records:
        kind_disp = fmt_sig(r["sig_hex"]) if r["kind"] == "crash" else r["kind"]
        if r["outcome"] == "survived":
            kind_disp = f"survived ({r['end_reason']}, rc={r['rc']})"
        elif r["kind"] == "stall":
            kind_disp = f"stall ({r['reason']})"
        acts = ", ".join(r["last_actions"]) if r["last_actions"] else "(none)"
        lines.append(
            f"| {md_escape(r['seed'])} | {md_escape(r['run'])} | {r['outcome']} | "
            f"{md_escape(kind_disp)} | {md_escape(r['elapsed'])} | {r['frames']} | "
            f"`{md_escape(acts)}` | `{r['path']}` |"
        )
    lines.append("")

    with open(args.out, "w", encoding="utf-8") as f:
        f.write("\n".join(lines))

    print(
        f"qexplore-report: {total_runs} runs ({fault_runs} faults: {crash_runs} crash, "
        f"{stall_runs} stall, {other_fault_runs} other; {survived_runs} survived), "
        f"{len(sorted_groups)} distinct fault signatures -> {args.out}"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
