#!/bin/sh
# qtap - boot Aidoku under qemu with hostpresent, run ctl actions, save shots.
# usage: tools/qtap OUTDIR "tap 995 3165" "wait 10" "shot" ...
# Optional: QCARENDER=1 (use carender path), QID=n (isolated instance).
OUT=${1:?outdir}; shift
D=/data/local/tmp/ioswine
if [ -n "${QID:-}" ]; then
  SFX="-q${QID}"
else
  SFX=""
fi
C="$D/hostpresent${SFX}.ctl"
QLOG="$D/q${SFX}.log"
PNG="$D/host-frame${SFX}.png"
QPIDFILE="$D/qemu${SFX}.pid"
mkdir -p "$OUT"
rm -f "$QLOG"
QPRESENT=1 QCARENDER="${QCARENDER:-0}" tools/qrun 400 > "$OUT/qrun.txt" 2>&1 &
QR=$!

count_frames() {
  if [ -f "$QLOG" ]; then
    cf_n=$(grep -acE '\[(snapshot|carender)\] frame ' "$QLOG" 2>/dev/null || true)
    echo "${cf_n:-0}"
  else
    echo 0
  fi
}

cleanup_run() {
  if [ -n "${QID:-}" ]; then
    kill "$QR" 2>/dev/null
    if [ -f "$QPIDFILE" ]; then
      qp=$(cat "$QPIDFILE" 2>/dev/null)
      [ -n "$qp" ] && kill "$qp" 2>/dev/null
    fi
  else
    kill $(pidof qemu-aarch64-ios) 2>/dev/null
  fi
  wait "$QR" 2>/dev/null
}

i=0
last_f=0
idle_s=0
while true; do
  f=$(count_frames)
  [ "$f" -ge 20 ] && break
  if [ "${QCARENDER:-0}" = "1" ] && [ "$f" -ge 1 ]; then
    if [ "$f" -gt "$last_f" ]; then
      last_f=$f
      idle_s=0
    else
      idle_s=$((idle_s + 1))
      [ "$idle_s" -ge 8 ] && break
    fi
  fi
  kill -0 "$QR" 2>/dev/null || { echo "app exited before boot"; break; }
  sleep 1
  i=$((i + 1))
  [ "$i" -gt 200 ] && { echo "no frames"; cleanup_run; exit 1; }
done
echo "booted in ${i}s (frames=$(count_frames))"
n=0
for a in "$@"; do
  case "$a" in
    wait*) sleep ${a#wait } ;;
    shot) n=$((n+1)); echo shot > "$C"; sleep 3; cp "$PNG" "$OUT/shot-$n.png"; echo "shot-$n" ;;
    *) echo "$a" > "$C"; echo "$a" ;;
  esac
  kill -0 "$QR" 2>/dev/null || { echo "app exited"; break; }
done
cleanup_run
cp "$QLOG" "$OUT/q.log"; cat "$OUT/qrun.txt"
